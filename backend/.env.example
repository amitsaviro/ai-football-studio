# https://dashboard.api-football.com — free plan key
API_FOOTBALL_KEY=

# https://console.anthropic.com
ANTHROPIC_API_KEY=

# https://goal-api.com
GOAL_API_KEY=

# Local Postgres (brew services start postgresql@18)
DATABASE_URL=postgresql:///football
# Read-only role for the run_sql tool (db/readonly_role.sql)
DATABASE_URL_READONLY=postgresql://pundit_ro@/football

# Pundit model settings (optional)
PUNDIT_MODEL=claude-opus-5
PUNDIT_EFFORT=medium
